{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "open": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "bans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },

    "lastPost": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.val() === now && (!data.exists() || data.val() <= now - 8000)"
      }
    },

    "messages": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('settings/open').val() !== false && root.child('bans').child(auth.uid).val() !== true && newData.parent().parent().child('lastPost').child(auth.uid).val() === now) || (root.child('admins').child(auth.uid).val() === true && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "ts": { ".validate": "newData.val() === now" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().matches(/(n+[i1!|l]+[gq9]{2,}|f+[a@4]+[gq9]+[o0e]*t|r+[e3]+t+[a@4]+r+d|k+[i1]+k+e|w+[e3]+t+b+[a@4]+c+k)/i)" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200 && !newData.val().matches(/(https?:|www\\.|\\.(com|net|org|gg|io|xyz|ly)|discord\\.gg)/i) && !newData.val().matches(/(n+[i1!|l]+[gq9]{2,}|f+[a@4]+[gq9]+[o0e]*t|r+[e3]+t+[a@4]+r+d|k+[i1]+k+e|w+[e3]+t+b+[a@4]+c+k)/i)" },
        "$other": { ".validate": false }
      }
    }
  }
}
